        },
        {
          "id": "abc2f5b19a1bd426bd969e5fdbf93e4a",
          "alias": "total_cost",
          "display_name": "Total cost",
          "sql": [
            "SUM(cost_by_dimension.cost)"
          ]
        },
        {
          "id": "d87a962a1be3ac6f906e0834bfa15cea",
          "alias": "estimated_monthly_savings",
          "display_name": "Estimated monthly savings",
          "sql": [
            "SUM(COALESCE(recommendations.est_monthly_savings, 0))"
          ]
        }
      ]
    }
  },
